#!/bin/sh
# Contrôle avant envoi (PRD 2.1, checklist D6) : chaque commit envoyé est
# scanné, y compris ceux créés sans passer par le contrôle avant commit
# (cherry-pick, rebase, revert, am). Activé avec les autres crochets.
set -eu
ACTION="envoi"
. "$(dirname "$0")/_commun.sh"

echo "▶ Contrôle avant envoi"
verifier_gitleaks
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
preparer_config "$tmp"

# Dépôt distant visé (argument 1 donné par git) : seuls les commits déjà connus
# de ses copies locales (refs/remotes/<nom>/, état du dernier « git fetch ») sont
# exclus du scan. Envoi vers une adresse plutôt qu'un nom : rien n'est exclu,
# tout l'historique est scanné.
distant="$1"
zero="0000000000000000000000000000000000000000"
# « || [ -n … ] » : la dernière ligne est lue même sans retour à la ligne final.
while read -r local_ref local_sha remote_ref remote_sha || [ -n "${local_ref:-}" ]; do
  # Suppression d'une branche distante : rien à scanner.
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # Nouvelle branche : les commits absents des copies locales du dépôt
    # distant. Identifiants seulement (jamais le nom du dépôt, qui peut
    # contenir une espace et fausser les options passées à gitleaks).
    # shellcheck disable=SC2046
    set -- "$local_sha" --not $(git for-each-ref --format='%(objectname)' "refs/remotes/$distant/")
  else
    git cat-file -e "$remote_sha^{commit}" 2>/dev/null \
      || refuser "Version distante inconnue sur cet ordinateur (lancer « git fetch », puis recommencer)"
    set -- "$remote_sha..$local_sha"
  fi
  # a. Scan par fichier (garde l'exception étroite de skills-lock.json), en
  #    texte brut (--text, --no-textconv, --no-ext-diff : ni un fichier
  #    « binaire » ni un filtre git local ne masquent le contenu), fusions
  #    comprises. Une erreur de git sous gitleaks se voit à ses lignes « ERR ».
  scanner_git "$tmp" \
    --log-opts="--text --no-textconv --no-ext-diff --full-history --diff-merges=first-parent $*" .
  # b. Tout le contenu, sans exclusion par nom de fichier (sauf skills-lock.json,
  #    scanné en a.). Fusions comprises (contenu ajouté en résolvant un conflit) ;
  #    --full-history : aucun côté d'une fusion n'est écarté.
  GIT_ATTR_SOURCE="$ARBRE_VIDE" git log -p --text --no-ext-diff --no-textconv \
    --full-history --diff-merges=first-parent "$@" \
    -- . ':(exclude).claude/skills/skills-lock.json' >"$tmp/envoi.diff"
  scanner_diff "$tmp/envoi.diff" "$tmp"
  # Remis à vide : sans cela, la condition de la boucle relirait sans fin.
  local_ref=""
done

echo "✔ Contrôle avant envoi : tout est vert"
