#!/bin/sh
# Contrôle avant commit (PRD 2.1, checklist D6) : aucun commit n'est créé
# sans ces vérifications. Activation une fois par copie du dépôt :
#   npm run hooks:install
# Un contrôle en échec refuse le commit. Le contournement (--no-verify) est
# interdit (PRD 2.1, règles d'usage des skills). pre-push rescanne tout
# commit envoyé ; la CI GitHub rejoue tout.
set -eu
ACTION="commit"
. "$(dirname "$0")/_commun.sh"

echo "▶ Contrôle avant commit"

# 1. Outils identiques (D4) : la version de Node fixée par .nvmrc.
expected_node="v$(cat .nvmrc)"
if [ "$(node -v 2>/dev/null || true)" != "$expected_node" ] && [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  # nvm n'est pas compatible avec « set -eu » : options suspendues le temps du chargement.
  set +eu
  . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" --no-use
  nvm use --silent >/dev/null 2>&1
  set -eu
fi
[ "$(node -v 2>/dev/null || true)" = "$expected_node" ] \
  || refuser "Node $expected_node requis (voir .nvmrc)"
[ -x ./node_modules/.bin/lint-staged ] \
  || refuser "Dépendances absentes (lancer « npm ci », puis recommencer)"

# 2. Secrets (D6), sur le contenu exact du commit.
verifier_gitleaks
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
preparer_config "$tmp"
# a. Scan par fichier (garde l'exception étroite de skills-lock.json).
GIT_ATTR_SOURCE="$ARBRE_VIDE" gitleaks git --pre-commit --staged --redact --no-banner \
  --config "$tmp/config.toml" --gitleaks-ignore-path "$tmp" --ignore-gitleaks-allow \
  || refuser "Secret détecté. Retirer le secret du fichier (valeur jamais recopiée ailleurs)"
# b. Tout le contenu du commit, sans exclusion par nom de fichier.
GIT_ATTR_SOURCE="$ARBRE_VIDE" git diff --cached -U0 --text --no-ext-diff --no-textconv \
  -- . ':(exclude).claude/skills/skills-lock.json' >"$tmp/commit.diff"
scanner_diff "$tmp/commit.diff" "$tmp"

# 3. Mise en forme et qualité du code, sur les seuls fichiers du commit.
./node_modules/.bin/lint-staged --config .lintstagedrc.mjs

# 4. Types, à chaque commit, sur une copie exacte du contenu du commit
#    (suppressions comprises, fichiers hors commit ignorés). Outils appelés
#    directement : une modification des scripts de package.json ne peut pas
#    vider ce contrôle.
git checkout-index -a --prefix="$tmp/commit/"
ln -s "$PWD/node_modules" "$tmp/commit/node_modules"
(cd "$tmp/commit" && ./node_modules/.bin/next typegen && ./node_modules/.bin/tsc --noEmit)

echo "✔ Contrôle avant commit : tout est vert"
