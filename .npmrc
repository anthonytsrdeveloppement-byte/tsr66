# Sécurité de la chaîne d'approvisionnement (PRD D4, skill security-and-hardening)
# Aucun script d'installation de dépendance n'est exécuté sans relecture.
ignore-scripts=true
# Version de Node imposée par le projet (voir .nvmrc et "engines").
engine-strict=true
# Versions exactes, jamais de plage.
save-exact=true
# Aucune version publiée depuis moins de 7 jours (prudence contre les versions
# piégées), même délai que Dependabot (.github/dependabot.yml). Sans exception
# ici : un correctif de sécurité plus récent s'installe sur décision explicite.
min-release-age=7
